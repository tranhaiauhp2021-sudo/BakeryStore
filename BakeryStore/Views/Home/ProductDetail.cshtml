@model BakeryStore.Models.ProductDetailVM
@{ViewBag.Title=Model.Product.ProductName;}
<section class="page-banner compact"><div class="container"><p><a href="@Url.Action("Index")">Trang chủ</a> <i class="fas fa-angle-right"></i> <a href="@Url.Action("ProductList")">Cửa hàng</a> <i class="fas fa-angle-right"></i> @Model.Product.ProductName</p></div></section>
<section class="section"><div class="container detail-layout"><div class="detail-photo"><img src="@(string.IsNullOrWhiteSpace(Model.Product.ProductImage)?Url.Content("~/Content/images/placeholder.svg"):Model.Product.ProductImage)" alt="@Model.Product.ProductName" onerror="this.onerror=null;this.src='/Content/images/placeholder.svg';"/></div><div class="detail-info"><span class="eyebrow dark">FRESHLY BAKED · @Model.Product.Category.CategoryName</span><h1>@Model.Product.ProductName</h1><div class="stars">★★★★★ <span>Được làm tươi mỗi ngày</span></div><div class="detail-price">@Model.Product.ProductPrice.ToString("N0")₫</div><p class="detail-description">@Model.Product.ProductDecription</p><p class="stock"><i class="fas fa-check-circle"></i> Có sẵn · Bánh mới mỗi ngày</p>
@using(Html.BeginForm("Add","Cart",FormMethod.Post,new{@class="buy-form"})){@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Product.ProductID"/><div class="qty"><button type="button" class="qty-minus" aria-label="Giảm">−</button><input type="number" name="quantity" min="1" max="99" value="1"/><button type="button" class="qty-plus" aria-label="Tăng">+</button></div><button class="btn btn-primary" type="submit"><i class="fas fa-shopping-bag"></i> Thêm vào giỏ hàng</button>}
<div class="detail-perks"><div><i class="fas fa-truck"></i> Giao hàng tiện lợi</div><div><i class="fas fa-heart"></i> Làm bằng cả trái tim</div><div><i class="fas fa-leaf"></i> Nguyên liệu chọn lọc</div></div></div></div></section>
@if(Model.Related.Count>0){<section class="section light-section"><div class="container"><div class="section-heading"><span class="eyebrow dark">YOU MAY ALSO LOVE</span><h2>Bánh tương tự <em>dành cho bạn</em></h2></div><div class="product-grid">@foreach(var p in Model.Related){@Html.Partial("~/Views/Shared/_ProductCard.cshtml",p)}</div></div></section>}
