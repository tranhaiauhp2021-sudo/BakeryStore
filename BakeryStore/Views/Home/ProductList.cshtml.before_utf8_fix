@model BakeryStore.Models.CatalogVM
@{ViewBag.Title="Cửa hàng bánh";}
<section class="page-banner"><div class="container"><span class="eyebrow dark">MADE WITH LOVE</span><h1>@(Model.CategoryName??"Cửa hàng bánh")</h1><p>Trang chủ <i class="fas fa-angle-right"></i> Cửa hàng</p></div></section>
<section class="section catalog"><div class="container catalog-layout"><aside class="sidebar"><h3>Danh mục bánh</h3><a class="@(Model.CategoryId==null?"selected":"")" href="@Url.Action("ProductList")">Tất cả bánh <i class="fas fa-arrow-right"></i></a>@foreach(var c in Model.Categories){<a class="@(Model.CategoryId==c.CategoryID?"selected":"")" href="@Url.Action("ProductList",new{id=c.CategoryID})">@c.CategoryName <i class="fas fa-arrow-right"></i></a>}<div class="sidebar-promo"><i class="fas fa-gift"></i><strong>Hương vị hạnh phúc</strong><p>Những chiếc bánh nhỏ dành cho khoảnh khắc lớn.</p></div></aside>
<div class="catalog-main"><form action="@Url.Action("ProductList")" method="get" class="catalog-toolbar"><input type="hidden" name="id" value="@Model.CategoryId"/><div class="catalog-search"><input name="search" value="@Model.Search" placeholder="Bạn muốn ăn bánh gì hôm nay?"/><button type="submit" aria-label="Tìm"><i class="fas fa-search"></i></button></div><select name="sort" onchange="this.form.submit()"><option value="new" @(Model.Sort=="new"?"selected":"")>Mới nhất</option><option value="price_asc" @(Model.Sort=="price_asc"?"selected":"")>Giá: Thấp đến cao</option><option value="price_desc" @(Model.Sort=="price_desc"?"selected":"")>Giá: Cao đến thấp</option><option value="name" @(Model.Sort=="name"?"selected":"")>Tên A → Z</option></select></form>
@if(Model.Products.Count==0){<div class="empty">Không có sản phẩm phù hợp.</div>}else{<div class="product-grid">@foreach(var p in Model.Products){@Html.Partial("~/Views/Shared/_ProductCard.cshtml",p)}</div>}
@if(Model.TotalPages>1){<div class="pagination">@for(int i=1;i<=Model.TotalPages;i++){<a class="@(Model.Page==i?"active":"")" href="@Url.Action("ProductList",new{id=Model.CategoryId,search=Model.Search,sort=Model.Sort,page=i})">@i</a>}</div>}
</div></div></section>
