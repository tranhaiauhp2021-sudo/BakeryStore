@model BakeryStore.Models.CartVM
@{ViewBag.Title="Giỏ hàng";}
<section class="page-banner"><div class="container"><span class="eyebrow dark">YOUR SWEET TREATS</span><h1>Giỏ hàng của bạn</h1><p>Trang chủ <i class="fas fa-angle-right"></i> Giỏ hàng</p></div></section>
<section class="section"><div class="container">
@if(!Model.Items.Any()){<div class="empty-cart"><i class="fas fa-shopping-basket"></i><h2>Giỏ hàng đang trống</h2><p>Thêm vài món bánh thơm ngon vào giỏ nhé!</p><a href="@Url.Action("ProductList","Home")" class="btn btn-primary">Khám phá bánh ngon</a></div>}
else{<div class="cart-layout"><div class="cart-table"><div class="cart-header"><span>Sản phẩm</span><span>Giá</span><span>Số lượng</span><span>Tạm tính</span><span></span></div>
@foreach(var item in Model.Items){<div class="cart-row"><div class="cart-item"><img src="@item.ProductImage" onerror="this.onerror=null;this.src='/Content/images/placeholder.svg';" alt=""/><div><a href="@Url.Action("ProductDetail","Home",new{id=item.ProductID})">@item.ProductName</a><small>Bánh tươi mỗi ngày</small></div></div><span>@item.ProductPrice.ToString("N0")₫</span>@using(Html.BeginForm("Update","Cart",FormMethod.Post,new{@class="cart-update"})){@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@item.ProductID"/><input type="number" min="0" max="99" name="quantity" value="@item.Quantity"/><button type="submit" title="Cập nhật"><i class="fas fa-sync"></i></button>}<strong>@item.Subtotal.ToString("N0")₫</strong>@using(Html.BeginForm("Remove","Cart",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@item.ProductID"/><button type="submit" class="remove" title="Xóa"><i class="fas fa-times"></i></button>}</div>}
<a class="text-link continue" href="@Url.Action("ProductList","Home")"><i class="fas fa-arrow-left"></i> Tiếp tục mua sắm</a></div><aside class="order-summary"><h3>Tóm tắt đơn hàng</h3><div><span>Tạm tính</span><strong>@Model.Total.ToString("N0")₫</strong></div><div><span>Phí giao hàng</span><span>Tính khi xác nhận</span></div><hr/><div class="total"><span>Tổng cộng</span><strong>@Model.Total.ToString("N0")₫</strong></div><a class="btn btn-primary full" href="@Url.Action("Checkout","Order")">Tiến hành đặt hàng <i class="fas fa-arrow-right"></i></a><p><i class="fas fa-lock"></i> Thanh toán COD an toàn</p></aside></div>}
</div></section>
