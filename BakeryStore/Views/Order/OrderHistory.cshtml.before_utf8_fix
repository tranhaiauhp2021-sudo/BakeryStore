@model IEnumerable<BakeryStore.Models.Order>
@{ViewBag.Title="Lịch sử mua hàng";}
<section class="page-banner compact"><div class="container"><h1>Lịch sử mua hàng</h1></div></section><section class="section"><div class="container"><div class="history-wrap"><table class="simple-table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Trạng thái</th><th>Số món</th><th>Tổng tiền</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td><span class="status-pill">@o.PaymentStatus</span></td><td>@o.OrderDetails.Sum(x=>x.Quantity)</td><td><strong>@o.TotalAmount.ToString("N0")₫</strong></td><td><a href="@Url.Action("OrderSuccess",new{id=o.OrderID})">Chi tiết</a></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">Bạn chưa có đơn hàng nào. <a href="@Url.Action("ProductList","Home")">Khám phá bánh ngon</a></div>}</div></div></section>
