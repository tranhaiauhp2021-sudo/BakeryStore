@model BakeryStore.Models.Order
@{ViewBag.Title="Đặt hàng thành công";}
<section class="section"><div class="container"><div class="success-order"><div class="success-icon"><i class="fas fa-check"></i></div><span class="eyebrow dark">THANK YOU FOR YOUR ORDER</span><h1>Đặt hàng thành công!</h1><p>Cảm ơn bạn đã tin chọn Bakery Store. Chúng mình sẽ chuẩn bị bánh thật ngon nhé ♡</p><div class="receipt"><div><span>Mã đơn hàng</span><strong>#@Model.OrderID</strong></div><div><span>Ngày đặt</span><strong>@Model.OrderDate.ToString("dd/MM/yyyy")</strong></div><div><span>Trạng thái</span><strong>@Model.PaymentStatus</strong></div><div><span>Tổng tiền</span><strong>@Model.TotalAmount.ToString("N0")₫</strong></div></div><a class="btn btn-primary" href="@Url.Action("OrderHistory")">Lịch sử đơn hàng</a><a class="text-link" href="@Url.Action("Index","Home")">Quay lại mua sắm</a></div></div></section>
