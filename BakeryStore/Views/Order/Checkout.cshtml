@model BakeryStore.Models.CheckoutVM
@{ViewBag.Title="Đặt hàng";}
<section class="page-banner compact"><div class="container"><h1>Hoàn tất đặt hàng</h1></div></section><section class="section"><div class="container checkout-layout"><div class="auth-card"><span class="eyebrow dark">SHIPPING INFORMATION</span><h2>Thông tin giao hàng</h2><p>Thanh toán khi nhận hàng (COD).</p>
@using(Html.BeginForm("Checkout","Order",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label>Địa chỉ nhận bánh</label>@Html.TextAreaFor(m=>m.AddressDelivery,new{@class="field",rows="4",placeholder="Số nhà, đường, phường, quận, thành phố..."})<button class="btn btn-primary full" type="submit">Xác nhận đặt hàng <i class="fas fa-arrow-right"></i></button>}</div><aside class="order-summary"><h3>Đơn bánh của bạn</h3>@foreach(var i in Model.Cart.Items){<div><span>@i.ProductName × @i.Quantity</span><strong>@i.Subtotal.ToString("N0")₫</strong></div>}<hr/><div class="total"><span>Tổng cộng</span><strong>@Model.Cart.Total.ToString("N0")₫</strong></div><p>Phí giao hàng sẽ được cửa hàng thông báo sau khi xác nhận.</p></aside></div></section>
