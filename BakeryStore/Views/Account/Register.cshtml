@model BakeryStore.Models.RegisterVM
@{ViewBag.Title="Tạo tài khoản";}
<section class="page-banner compact"><div class="container"><h1>Đăng ký tài khoản</h1></div></section>
<section class="section"><div class="container auth-container"><div class="auth-card"><span class="eyebrow dark">JOIN THE BAKERY CLUB</span><h2>Chào mừng bạn ♡</h2><p>Cùng Bakery Store chia sẻ những khoảnh khắc ngọt ngào.</p>
@using(Html.BeginForm("Register","Account",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})
<label>Tên đăng nhập</label>@Html.TextBoxFor(m=>m.Username,new{@class="field",placeholder="Tên đăng nhập"})
<div class="form-grid"><div><label>Mật khẩu</label>@Html.PasswordFor(m=>m.Password,new{@class="field",placeholder="Ít nhất 8 ký tự"})</div><div><label>Nhập lại mật khẩu</label>@Html.PasswordFor(m=>m.ConfirmPassword,new{@class="field",placeholder="Nhập lại mật khẩu"})</div></div>
<label>Họ và tên</label>@Html.TextBoxFor(m=>m.CustomerName,new{@class="field",placeholder="Nguyễn Văn A"})
<div class="form-grid"><div><label>Số điện thoại</label>@Html.TextBoxFor(m=>m.CustomerPhone,new{@class="field"})</div><div><label>Email</label>@Html.TextBoxFor(m=>m.CustomerEmail,new{@class="field",type="email"})</div></div>
<label>Địa chỉ</label>@Html.TextBoxFor(m=>m.CustomerAddress,new{@class="field"})
<button class="btn btn-primary full" type="submit">Tạo tài khoản <i class="fas fa-arrow-right"></i></button>}
<p class="auth-switch">Đã có tài khoản? <a href="@Url.Action("Login")">Đăng nhập ngay</a></p></div></div></section>
