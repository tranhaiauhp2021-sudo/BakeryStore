@model IEnumerable<BakeryStore.Models.Order>
@{ViewBag.Title="Tổng quan";}
<div class="page-head"><div><span class="mini-title">DASHBOARD</span><h1>Chào mừng quay lại! 👋</h1><p>Đây là tình hình cửa hàng Bakery Store hôm nay.</p></div><a class="btn" href="@Url.Action("Create","Products")"><i class="fas fa-plus"></i> Thêm sản phẩm</a></div>
<div class="stat-grid"><div class="stat"><i class="fas fa-cookie-bite"></i><p>Sản phẩm</p><strong>@ViewBag.ProductCount</strong></div><div class="stat"><i class="fas fa-layer-group"></i><p>Danh mục</p><strong>@ViewBag.CategoryCount</strong></div><div class="stat"><i class="fas fa-users"></i><p>Khách hàng</p><strong>@ViewBag.CustomerCount</strong></div><div class="stat"><i class="fas fa-box"></i><p>Đơn hàng</p><strong>@ViewBag.OrderCount</strong></div></div>
<div class="panel"><div class="panel-heading"><h2>Đơn hàng gần đây</h2><a href="@Url.Action("Index","Orders")">Xem tất cả →</a></div><div class="table-scroll"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày</th><th>Tổng</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.OrderID</td><td>@o.Customer.CustomerName</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.TotalAmount.ToString("N0")₫</td><td><span class="pill">@o.PaymentStatus</span></td><td><a href="@Url.Action("Details","Orders",new{id=o.OrderID})">Xem</a></td></tr>}</tbody></table></div></div>
