<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewBag.Title - Bakery Admin</title><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"/><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet"/><link href="@Url.Content("~/Content/admin.css")" rel="stylesheet"/></head><body><div class="admin-shell"><aside class="admin-sidebar"><a href="@Url.Action("Index","Home")" class="admin-logo"><i class="fas fa-birthday-cake"></i> bakery<span>.</span><small>ADMIN PANEL</small></a><div class="side-caption">QUẢN LÝ CỬA HÀNG</div><a href="@Url.Action("Index","Home")"><i class="fas fa-th-large"></i> Tổng quan</a><a href="@Url.Action("Index","Categories")"><i class="fas fa-list"></i> Danh mục</a><a href="@Url.Action("Index","Products")"><i class="fas fa-cookie"></i> Sản phẩm</a><a href="@Url.Action("Index","Customers")"><i class="fas fa-user-friends"></i> Khách hàng</a><a href="@Url.Action("Index","Orders")"><i class="fas fa-box"></i> Đơn hàng</a><a href="@Url.Action("Index","AdminUsers")"><i class="fas fa-user-shield"></i> Quản trị viên</a><div class="side-caption">KHÁC</div><a href="@Url.Action("Index","Home",new{area=""})"><i class="fas fa-external-link-alt"></i> Xem cửa hàng</a>@using(Html.BeginForm("Logout","Account",new{area=""},FormMethod.Post)){@Html.AntiForgeryToken()<button type="submit" class="sidebar-logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>}</aside><main class="admin-main"><header class="admin-header"><strong>Hệ thống quản lý Bakery Store</strong><span><i class="far fa-user-circle"></i> @Session["Username"]</span></header><div class="admin-content">@if(TempData["Success"]!=null){<div class="flash good">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="flash bad">@TempData["Error"]</div>}@RenderBody()</div></main></div></body></html>
