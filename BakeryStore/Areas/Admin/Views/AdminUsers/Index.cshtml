@model IEnumerable<BakeryStore.Models.UserAccount>
@{ViewBag.Title="Quản trị viên";}
<div class="page-head"><div><span class="mini-title">ADMIN ACCOUNTS</span><h1>Tài khoản quản trị</h1></div><a class="btn" href="@Url.Action("Create")"><i class="fas fa-plus"></i> Thêm admin</a></div><div class="panel"><div class="table-scroll"><table><thead><tr><th>Username</th><th>Role</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Username</td><td><span class="pill">Admin</span></td><td><a href="@Url.Action("Edit",new{id=u.Username})">Đổi mật khẩu</a> @using(Html.BeginForm("Delete","AdminUsers",FormMethod.Post,new{style="display:inline"})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Username"/><button class="link-danger" type="submit" onclick="return confirm('Xóa quản trị viên này?')">Xóa</button>}</td></tr>}</tbody></table></div></div>
