@model BakeryStore.Models.AdminUserVM
@{ViewBag.Title="Đổi mật khẩu admin";}
<div class="page-head"><h1>Đổi mật khẩu: @Model.Username</h1></div><div class="panel form-panel">@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.HiddenFor(m=>m.Username) @Html.ValidationSummary(false,"",new{@class="error"})<label>Mật khẩu mới</label>@Html.PasswordFor(m=>m.Password,new{@class="field",required="required",minlength="8"})<button type="submit" class="btn">Cập nhật</button>}</div>