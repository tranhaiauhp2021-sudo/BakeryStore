@model BakeryStore.Models.Customer
@{ViewBag.Title="Chi tiết khách hàng";}
<div class="page-head"><h1>Khách hàng: @Model.CustomerName</h1><a href="@Url.Action("Index")">← Quay lại</a></div><div class="panel form-panel"><p><b>Tài khoản:</b> @Model.Username</p><p><b>Điện thoại:</b> @Model.CustomerPhone</p><p><b>Email:</b> @Model.CustomerEmail</p><p><b>Địa chỉ:</b> @Model.CustomerAddress</p></div><div class="panel"><div class="panel-heading"><h2>Lịch sử đơn hàng</h2></div><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Ngày</th><th>Trạng thái</th><th>Tổng tiền</th><th></th></tr></thead><tbody>@foreach(var o in Model.Orders.OrderByDescending(o=>o.OrderID)){<tr><td>#@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.PaymentStatus</td><td>@o.TotalAmount.ToString("N0")₫</td><td><a href="@Url.Action("Details","Orders",new{id=o.OrderID})">Xem</a></td></tr>}</tbody></table></div></div>
