@model IEnumerable<BakeryStore.Models.Customer>
@{ViewBag.Title="Khách hàng";}
<div class="page-head"><div><span class="mini-title">CUSTOMERS</span><h1>Khách hàng</h1><p>Thông tin liên hệ và lịch sử mua hàng.</p></div></div><div class="panel"><form class="filter-form" method="get"><input name="search" value="@ViewBag.Search" placeholder="Tên, tài khoản hoặc số điện thoại"/><button type="submit">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>ID</th><th>Tên khách hàng</th><th>Tài khoản</th><th>Số điện thoại</th><th>Email</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>#@c.CustomerID</td><td><strong>@c.CustomerName</strong></td><td>@c.Username</td><td>@c.CustomerPhone</td><td>@c.CustomerEmail</td><td><a href="@Url.Action("Details",new{id=c.CustomerID})">Đơn hàng →</a></td></tr>}</tbody></table></div></div>
