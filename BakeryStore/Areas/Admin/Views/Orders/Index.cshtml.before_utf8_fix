@model IEnumerable<BakeryStore.Models.Order>
@{ViewBag.Title="Đơn hàng";}
<div class="page-head"><div><span class="mini-title">ORDER MANAGEMENT</span><h1>Đơn hàng</h1><p>Theo dõi trạng thái các đơn bánh.</p></div></div><div class="panel"><form method="get" class="filter-form"><input name="search" value="@ViewBag.Search" placeholder="Tìm tên hoặc tài khoản khách hàng"/><button type="submit">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.OrderID</td><td>@o.Customer.CustomerName</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.TotalAmount.ToString("N0")₫</td><td><span class="pill">@o.PaymentStatus</span></td><td><a href="@Url.Action("Details",new{id=o.OrderID})">Chi tiết →</a></td></tr>}</tbody></table></div></div>
