@model BakeryStore.Models.Order
@{ViewBag.Title="Chi tiết đơn hàng";}
<div class="page-head"><div><span class="mini-title">ORDER DETAILS</span><h1>Đơn hàng #@Model.OrderID</h1><p>Khách: @Model.Customer.CustomerName · @Model.OrderDate.ToString("dd/MM/yyyy")</p></div><a href="@Url.Action("Index")">← Quay lại</a></div><div class="panel form-panel"><p><b>Giao tới:</b> @Model.AddressDelivery</p><p><b>Số điện thoại:</b> @Model.Customer.CustomerPhone</p><p><b>Trạng thái:</b> @Model.PaymentStatus</p>@using(Html.BeginForm("UpdateStatus","Orders",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.OrderID"/><label>Chuyển trạng thái</label><select class="field" name="status"><option>Chờ xác nhận - COD</option><option>Đang chuẩn bị</option><option>Đang giao</option><option>Đã hoàn thành</option><option>Đã hủy</option></select><button class="btn" type="submit">Cập nhật</button>}</div><div class="panel"><div class="panel-heading"><h2>Sản phẩm đã đặt</h2></div><div class="table-scroll"><table><thead><tr><th>Bánh</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var d in Model.OrderDetails){<tr><td>@d.Product.ProductName</td><td>@d.Quantity</td><td>@d.UnitPrice.ToString("N0")₫</td><td>@((d.Quantity*d.UnitPrice).ToString("N0"))₫</td></tr>}</tbody></table></div><div class="order-total">TỔNG CỘNG: <strong>@Model.TotalAmount.ToString("N0")₫</strong></div></div>
