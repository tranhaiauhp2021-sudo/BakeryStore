@model IEnumerable<BakeryStore.Models.Product>
@{ViewBag.Title="Sản phẩm";}
<div class="page-head"><div><span class="mini-title">PRODUCT MANAGEMENT</span><h1>Quản lý sản phẩm</h1><p>Thêm, chỉnh sửa, tìm kiếm và phân trang bánh.</p></div><a class="btn" href="@Url.Action("Create")"><i class="fas fa-plus"></i> Thêm bánh</a></div>
<div class="panel"><form method="get" class="filter-form"><input name="search" value="@ViewBag.Search" placeholder="Tìm sản phẩm..."/>@Html.DropDownList("categoryId",(SelectList)ViewBag.Categories,"Tất cả danh mục")<select name="sort"><option value="new">Mới nhất</option><option value="price_asc">Giá tăng</option><option value="price_desc">Giá giảm</option></select><button type="submit">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>ID</th><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>#@p.ProductID</td><td><div class="product-inline"><img src="@p.ProductImage" onerror="this.src='/Content/images/placeholder.svg'" alt=""/><strong>@p.ProductName</strong></div></td><td>@p.Category.CategoryName</td><td>@p.ProductPrice.ToString("N0")₫</td><td><a href="@Url.Action("Edit",new{id=p.ProductID})">Sửa</a> · <a class="danger" href="@Url.Action("Delete",new{id=p.ProductID})">Xóa</a></td></tr>}</tbody></table></div>
<div class="pagination">@for(int i=1;i<=ViewBag.TotalPages;i++){<a class="@(ViewBag.Page==i?"active":"")" href="@Url.Action("Index",new{search=ViewBag.Search,categoryId=ViewBag.CategoryId,sort=ViewBag.Sort,page=i})">@i</a>}</div></div>
